{
  "name": "dsh-full-permission-real",
  "version": "2.0.0",
  "description": "Verified inherited TrustedInstaller token with independent per-call DSH Auto review.",
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./icon.svg": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "market/index.json",
    "market/icons/*.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml",
      "platforms": [
        "win32"
      ]
    }
  },
  "icon": "./icon.svg",
  "engines": {
    "dsh": "0.2.2-rc.4",
    "node": ">=20"
  },
  "os": [
    "win32"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "windows",
    "permission-mode",
    "trustedinstaller",
    "auto-review"
  ],
  "scripts": {
    "test": "node --test test/review.mjs"
  },
  "license": "MIT",
  "author": "dsh-full-permission-real contributors",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/324641aliyun/dsh-full-permission-real.git"
  },
  "homepage": "https://github.com/324641aliyun/dsh-full-permission-real#readme",
  "bugs": {
    "url": "https://github.com/324641aliyun/dsh-full-permission-real/issues"
  }
}
